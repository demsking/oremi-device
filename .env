# Logging
LOG_LEVEL=DEBUG
# LOG_FILE=/var/log/oremi-device.log

# Device
OREMI_DEVICE_NODE_ID=living-room
OREMI_DEVICE_LANGUAGE=fr
OREMI_DEVICE_MICROPHONE_ENABLED=true
OREMI_DEVICE_SPEAKER_ENABLED=true
# OREMI_DEVICE_MICROPHONE_DEVICE=USB Microphone
# OREMI_DEVICE_MICROPHONE_DEVICE_INDEX=0
OREMI_DEVICE_DELAY=3
OREMI_DEVICE_CONVERSATION_TIMEOUT=15

# Ohunerin
OREMI_DEVICE_OHUNERIN_HOST=localhost
OREMI_DEVICE_OHUNERIN_PORT=45023
OREMI_DEVICE_OHUNERIN_THRESHOLD=0.65

# Andika
OREMI_DEVICE_ANDIKA_HOST=localhost
OREMI_DEVICE_ANDIKA_PORT=45315
OREMI_DEVICE_ANDIKA_MODEL=vosk-model-small-fr-0.22
OREMI_DEVICE_ANDIKA_SAMPLERATE=16000

# TLS
# OREMI_DEVICE_CERT_FILE=/path/to/ca-certificate.pem

# MQTT
OREMI_DEVICE_MQTT_BROKER=localhost
OREMI_DEVICE_MQTT_PORT=41883
# OREMI_DEVICE_MQTT_USERNAME=oremi
# OREMI_DEVICE_MQTT_PASSWORD=replace-with-a-secret
OREMI_DEVICE_MQTT_TOPIC=oremi/device
OREMI_DEVICE_MQTT_DISCOVERY=true
OREMI_DEVICE_MQTT_DISCOVERY_PREFIX=homeassistant

# Transcription topics, relative to OREMI_DEVICE_MQTT_TOPIC
OREMI_DEVICE_PARTIAL_TRANSCRIPTION_TOPIC=transcription/partial
OREMI_DEVICE_FINAL_TRANSCRIPTION_TOPIC=transcription/text
