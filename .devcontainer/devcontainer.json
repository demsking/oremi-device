{
  "name": "Oremi Device",
  "dockerComposeFile": [
    "workspace.yaml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspaces",
  "runServices": [
    "andika",
    "ohunerin",
    "mosquitto",
    "whisper-model",
    "whisper",
    "edge-tts",
    "kansa",
    "rediyo",
    "weather",
    "isinmi",
    "ollama",
    "akorin"
  ],
  "shutdownAction": "stopCompose",
  "mounts": [
    "source=/dev/snd,target=/dev/snd,type=bind,consistency=cached",
    "source=${localEnv:XDG_RUNTIME_DIR}/pulse/native,target=/var/config/pulse/native,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/pulse/cookie,target=/var/config/pulse/cookie,type=bind,consistency=cached"
  ],
  "postCreateCommand": [
    "uv export --no-hashes --no-emit-project --format requirements-txt > /tmp/requirements.txt && pip install --user -r /tmp/requirements.txt",
    "make install"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.pylint",
        "ms-python.python",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "openai.chatgpt",
        "ms-pyright.pyright",
        "ms-python.debugpy"
      ],
      "settings": {
        "files.exclude": {
          "**/.devbox": true,
          "**/.venv": true
        },
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.pythonPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvInCurrentTerminal": true,
        "pylint.importStrategy": "fromEnvironment",
        "editor.formatOnPaste": false,
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "files.trimTrailingWhitespace": true,
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/usr/bin/bash"
          }
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  "features": {
    "ghcr.io/ait-assistive-autonomous-systems/devcontainer_features/add-groups:0": {
      "addGroups": "file://.devcontainers/host_groups",
      "excludeGroups": "()"
    }
  }
}