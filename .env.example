# Oremi Device Environment Configuration
# ============================================================
# All settings can also be set as environment variables directly.
# Every application setting uses the OREMI_DEVICE_ prefix.
# ============================================================

# Device
OREMI_DEVICE_NODE_ID=living-room
OREMI_DEVICE_MICROPHONE_ENABLED=true
OREMI_DEVICE_SPEAKER_ENABLED=true
# OREMI_DEVICE_MICROPHONE_DEVICE=USB Microphone
# OREMI_DEVICE_MICROPHONE_DEVICE_INDEX=0
OREMI_DEVICE_DELAY=3
OREMI_DEVICE_CONVERSATION_TIMEOUT=15
OREMI_DEVICE_AKORIN_URL=http://localhost:45020

# Device context
OREMI_DEVICE_LANGUAGE=fr
OREMI_DEVICE_LOCATION=Douala, Cameroon
OREMI_DEVICE_TIMEZONE=Africa/Douala
OREMI_DEVICE_TEMPERATURE_UNIT=celsius
OREMI_DEVICE_PREFERRED_CURRENCY=XAF
OREMI_DEVICE_MEASUREMENT_SYSTEM=metric
OREMI_DEVICE_DISTANCE_UNIT=kilometer
OREMI_DEVICE_TIME_FORMAT=24h
OREMI_DEVICE_DATE_FORMAT=DD/MM/YYYY
OREMI_DEVICE_FIRST_DAY_OF_WEEK=monday

# Transcription
OREMI_DEVICE_TRANSCRIPTION_BACKEND=andika
# OREMI_DEVICE_TRANSCRIPTION_BACKEND=whisper.cpp
# OREMI_DEVICE_TRANSCRIPTION_BACKEND=whisper.cpp
OREMI_DEVICE_WHISPER_URL=http://localhost:48080
OREMI_DEVICE_WHISPER_SILENCE_THRESHOLD=500
OREMI_DEVICE_WHISPER_SILENCE_DURATION=1.0

# Speech synthesis
OREMI_DEVICE_TTS_BACKEND=edge-tts
OREMI_DEVICE_EDGE_TTS_URL=http://localhost:45050
OREMI_DEVICE_EDGE_TTS_API_KEY=your_api_key_here
OREMI_DEVICE_EDGE_TTS_LOCALE=fr-FR

# Ohunerin
OREMI_DEVICE_OHUNERIN_HOST=localhost
OREMI_DEVICE_OHUNERIN_PORT=45023
OREMI_DEVICE_OHUNERIN_THRESHOLD=0.25

# Andika fallback
OREMI_DEVICE_ANDIKA_HOST=localhost
OREMI_DEVICE_ANDIKA_PORT=45315
OREMI_DEVICE_ANDIKA_MODEL=vosk-model-small-fr-0.22
OREMI_DEVICE_ANDIKA_SAMPLERATE=16000

# TLS
# OREMI_DEVICE_CERT_FILE=/path/to/ca-certificate.pem

# -- LLM Settings ----------------------------------------------------------------
# Fully qualified Pydantic AI model identifier.
# Use ollama:<model-name> for an Ollama-backed model.
OREMI_DEVICE_LLM_MODEL=ollama:qwen3.5:2b

# Ollama base URL. Required only when OREMI_DEVICE_LLM_MODEL starts with ollama:.
# Must be explicitly configured; there is no default.
OREMI_DEVICE_OLLAMA_BASE_URL=http://localhost:11434

# -- MQTT Settings ---------------------------------------------------------------
OREMI_DEVICE_MQTT_BROKER=localhost
# OREMI_DEVICE_MQTT_PORT=41883
OREMI_DEVICE_MQTT_PORT=51883
# OREMI_DEVICE_MQTT_USERNAME=oremi
# OREMI_DEVICE_MQTT_PASSWORD=replace-with-a-secret
OREMI_DEVICE_MQTT_TOPIC=oremi/device
OREMI_DEVICE_MQTT_DISCOVERY=true
OREMI_DEVICE_MQTT_DISCOVERY_PREFIX=homeassistant

# -- Logging Settings ------------------------------------------------------------
# Logging level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
OREMI_DEVICE_LOG_LEVEL=INFO

# Path to log file. Leave unset to use the default configured by Settings.
# OREMI_DEVICE_LOG_FILE=/oremi/data/oremi-device.log

