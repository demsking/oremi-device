{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug with Andika",
      "type": "debugpy",
      "request": "launch",
      "module": "device",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.example",
      "justMyCode": true,
      "env": {
        "OREMI_DEVICE_LOG_LEVEL": "DEBUG",
        "OREMI_DEVICE_MQTT_BROKER": "ngaoundere",
        "OREMI_DEVICE_TRANSCRIPTION_BACKEND": "andika",
        "OREMI_DEVICE_OLLAMA_BASE_URL": "http://localhost:31434"
      }
    },
    {
      "name": "Debug with whisper.cpp",
      "type": "debugpy",
      "request": "launch",
      "module": "device",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.example",
      "justMyCode": true,
      "env": {
        "OREMI_DEVICE_LOG_LEVEL": "DEBUG",
        "OREMI_DEVICE_MQTT_BROKER": "ngaoundere",
        "OREMI_DEVICE_TRANSCRIPTION_BACKEND": "whisper.cpp",
        "OREMI_DEVICE_OLLAMA_BASE_URL": "http://localhost:31434"
      }
    }
  ]
}
