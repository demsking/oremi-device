{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Local",
      "type": "debugpy",
      "request": "launch",
      "module": "oremi_device",
      "args": [
        "--node-id",
        "oremi-localhost-01",
        "--language",
        "fr",
        "--andika-host",
        "localhost",
        "--andika-port",
        "45315",
        "--ohunerin-host",
        "localhost",
        "--ohunerin-port",
        "45023",
        "--mqtt-broker",
        "localhost",
        "--mqtt-port",
        "41883"
      ],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Container",
      "type": "debugpy",
      "request": "launch",
      "module": "oremi_device",
      "args": [
        "--node-id",
        "oremi-docker-01",
        "--language",
        "fr",
        "--andika-host",
        "andika",
        "--andika-port",
        "5315",
        "--ohunerin-host",
        "detector",
        "--ohunerin-port",
        "5023",
        "--mqtt-broker",
        "mosquitto",
        "--mqtt-port",
        "1883"
      ],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}